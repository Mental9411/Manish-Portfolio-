# Public Cloudflare Turnstile site key for the configured hostname.
VITE_TURNSTILE_SITE_KEY=

# Private server-side service credentials. Never add a VITE_ prefix here.
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Exact public origin (without a trailing slash). Defaults to the production Vercel URL.
SITE_ORIGIN=
